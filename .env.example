# Server Configuration
HOST=127.0.0.1
ALLOW_LAN=false
PORT=3000
NODE_ENV=production
DATA_DIR=
GITHUB_REPOSITORY=
# Optional fine-grained token with repository metadata read access (needed to verify private repos via GitHub API).
GITHUB_TOKEN=

# Client Optional Override (Vite build-time default, or leave unset to use same-origin / UI configuration)
# VITE_API_BASE_URL=http://localhost:3000

# Public / Hosted Application URL (for reference in notification links)
APP_URL=
# Exact comma-separated browser origins accepted by the API; no wildcard host patterns.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Twelve Data credentials are optional and read server-side only; the key remains private.
# Admin dashboard key entry is memory-only for the current process; use .env to survive restarts.
TWELVE_DATA_API_KEY=
TWELVEDATA_API_KEY=
PROVIDER_CIRCUIT_COOLDOWN_MS=300000

# Session / JWT encryption secret for secure server-side session management
SESSION_SECRET=

# Admin Master bootstrap password (required for production; never written to disk)
ADMIN_BOOTSTRAP_PASSWORD=
REGISTRATION_ENABLED=false
SESSION_CONFIG_PATH=config/sessions.json

# Telegram Alert Configuration (Manual research alert dispatches)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_COMMAND_POLLING=false
TELEGRAM_POLL_MS=10000

# SMTP Email Notification Configuration (Manual research alert dispatches)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
ENABLE_EMAIL_NOTIFICATIONS=false

# Engine and automatic scan safe defaults
ENGINE_FULL_MODE_ENABLED=false
AUTO_SCAN_ENABLED=false
AUTO_SCAN_TIMEFRAME=15m
SIGNAL_LEDGER_PATH=signal-ledger.jsonl
PAYOUT_MAX_AGE_HOURS=12
BROKER_UTC_OFFSET_MINUTES=0
DEAD_MAN_SWITCH_URL=
SUMMARY_STORAGE_CAP_MB=50
SCAN_SUMMARY_RING_SIZE=200
CHAT_HISTORY_ENABLED=true
MARKET_CALENDAR_PATH=config/market-calendar.json

# R8 research run variables (uncomment and set only for a real, authorized run)
# TWELVE_DATA_API_KEY=
# R8_PAIRS=EUR/USD
# R8_TIMEFRAMES=5m,15m,30m
# R8_START_DATE=
# R8_END_DATE=
# R8_PAYOUT_PCT=
# R8_NEWS_CSV=
# R8_ALLOW_NO_NEWS=1
# R8_CSV_INPUT_DIR=
# R8_CSV_DIR=
# R8_OUTPUT_DIR=data/r8
# R8_REQUEST_GAP_MS=8000

# Optional P3 live-provider integration test (requires the selected provider key above)
# P3_LIVE_INTEGRATION=1
# P3_LIVE_PROVIDER=TWELVE_DATA
# P3_LIVE_PAIR=EUR/USD
