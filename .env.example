# Server Configuration
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Client Optional Override (Vite build-time default, or leave unset to use same-origin / UI configuration)
# VITE_API_BASE_URL=http://localhost:3000

# Client Optional Override (leave unset to use same-origin / UI configuration)
# GEMINI_API_KEY: Required for Gemini AI natural-language assistant & OCR modules (server-side only)
GEMINI_API_KEY=

# Public / Hosted Application URL (for reference in notification links)
APP_URL=
# Exact comma-separated browser origins accepted by the API; no wildcard host patterns.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Market data keys are optional and read server-side only. Automatic scan fallback order:
# Twelve Data -> OANDA v20 Practice -> Tiingo FX.
# Configure only providers for which you have legitimate API access; all keys remain private.
# Admin dashboard key entry is memory-only for the current process; use .env to survive restarts.
# Tiingo FX REST is beta; verify timezone/resampling in your account before operational use.
# OANDA generic instrument candles use the practice token; account ID is not needed for that endpoint.
TWELVE_DATA_API_KEY=
TWELVEDATA_API_KEY=
OANDA_PRACTICE_TOKEN=
OANDA_ACCOUNT_ID=
TIINGO_API_KEY=
PROVIDER_CIRCUIT_COOLDOWN_MS=300000

# Session / JWT encryption secret for secure server-side session management
SESSION_SECRET=

# Admin Master bootstrap password (Optional: if unset, an initial random secret is safely written to data/.admin_bootstrap_secret)
ADMIN_BOOTSTRAP_PASSWORD=

# Telegram Alert Configuration (Manual research alert dispatches)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_COMMAND_POLLING=false
TELEGRAM_POLL_MS=10000

# SMTP Email Notification Configuration (Manual research alert dispatches)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=
ENABLE_EMAIL_NOTIFICATIONS=false

# Engine and automatic scan safe defaults
ENGINE_FULL_MODE_ENABLED=false
AUTO_SCAN_ENABLED=false
AUTO_SCAN_TIMEFRAME=15m
SIGNAL_LEDGER_PATH=data/signal-ledger.jsonl

# R8 research run variables (uncomment and set only for a real, authorized run)
# TWELVE_DATA_API_KEY=
# R8_PAIRS=EUR/USD
# R8_TIMEFRAMES=5m,15m,30m
# R8_START_DATE=
# R8_END_DATE=
# R8_PAYOUT_PCT=
# R8_NEWS_CSV=
# R8_ALLOW_NO_NEWS=1
# R8_CSV_INPUT_DIR=
# R8_CSV_DIR=
# R8_OUTPUT_DIR=data/r8
# R8_REQUEST_GAP_MS=8000
